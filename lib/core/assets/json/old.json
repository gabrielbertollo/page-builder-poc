{
    "home": {
        "type": "DrawerPage",
        "title": "Página Inicial",
        "drawer": {
            "type": "DrawerComponent"
        },
        "body": {
            "type": "GridViewComponent",
            "children": [
                {
                    "type": "CardComponent",
                    "title": "Ouvidoria",
                    "subtitle": "Algum problema?",
                    "iconUrl": "https://cdn-icons-png.flaticon.com/512/2838/2838912.png",
                    "verticalSize": 1,
                    "horizontalAlignment": "start",
                    "action": {
                        "type": "builder-navigation", 
                        "page": {
                            "type": "DrawerPage",
                            "title": "Ouvidoria",
                            "skeleton": {
                                "type": "FormSkeleton",
                                "children": [
                                    {
                                        "type": "TextSkeleton",
                                        "characterLength": 400
                                    },
                                    {
                                        "type": "TextInputSkeleton"
                                    },
                                    {
                                        "type": "TextInputSkeleton"
                                    },
                                    {
                                        "type": "TextInputSkeleton"
                                    },
                                    {
                                        "type": "TextInputSkeleton"
                                    },
                                    {
                                        "type": "FileInputSkeleton"
                                    }
                                ]
                            }
                        }
                    }
                },
                {
                    "type": "CardComponent",
                    "title": "Blog",
                    "iconUrl": "https://cdn-icons-png.flaticon.com/512/2838/2838912.png",
                    "action": {
                        "type": "navigation",
                        "route": "/builder",
                        "requestUrl": "http://localhost:3000/blog",
                        "skeleton": {
                            "type": "SearchablePage",
                            "title": "Carregando",
                            "searchable": true,
                            "body": {
                                "type": "GridViewSkeleton",
                                "cardScale": 350.0,
                                "minColumnCount": 1,
                                "content": {
                                    "type": "PostSkeleton",
                                    "hasPublishedAt": true,
                                    "title": {
                                        "type": "TextSkeleton",
                                        "characterLength": 400,
                                        "fontSize": 20.0
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "type": "CardComponent",
                    "title": "Conheça a Cidade",
                    "iconUrl": "https://cdn-icons-png.flaticon.com/512/2838/2838912.png",
                    "action": {
                        "type": "modal",
                        "child": {
                            "title": {
                                "type": "TextComponent",
                                "text": "Login necessário"
                            },
                            "content": {
                                "type": "TextComponent",
                                "text": "Para acessar essa funcionalidade é necessário estar logado"
                            },
                            "actions": [
                                {
                                    "type": "ButtonComponent",
                                    "label": "Cancelar",
                                    "filled": false,
                                    "action": {
                                        "type": "navigation",
                                        "route": "/builder",
                                        "requestUrl": "http://localhost:3000/home"
                                    }
                                },
                                {
                                    "type": "ButtonComponent",
                                    "label": "Login",
                                    "action": {
                                        "type": "navigation",
                                        "route": "/builder",
                                        "requestUrl": "http://localhost:3000/home"
                                    }
                                }
                            ]
                        }
                    }
                },
                {
                    "type": "CardComponent",
                    "title": "Betha Educação",
                    "iconUrl": "https://cdn-icons-png.flaticon.com/512/2838/2838912.png",
                    "action": {
                        "type": "navigation",
                        "route": "/builder",
                        "requestUrl": "http://localhost:3000/betha"
                    }
                }
            ]
        }
    },
    "blog": {
        "type": "SearchablePage",
        "title": "Página Inicial",
        "searchable": true, 
        "body": {
            "type": "GridViewComponent",
            "cardScale": 350.0,
            "minColumnCount": 1,
            "children": [
                {
                    "type": "PostComponent",
                    "title": {
                        "type": "TextComponent",
                        "text": "Post 1"
                    },
                    "publishedAt": "Two days ago",
                    "imageUrl": "https://source.unsplash.com/600x300?purple,abstract&random=50",
                    "action": {
                        "type": "navigation",
                        "route": "/builder",
                        "requestUrl": "http://localhost:3000/home"
                    }
                },
                {
                    "type": "PostComponent",
                    "title": {
                        "type": "TextComponent",
                        "text": "Post 1"
                    },
                    "publishedAt": "Two days ago",
                    "imageUrl": "https://source.unsplash.com/600x300?purple,abstract&random=80",
                    "action": {
                        "type": "navigation",
                        "route": "/media"
                    }
                },
                {
                    "type": "PostComponent",
                    "title": {
                        "type": "TextComponent",
                        "text": "Post 1"
                    },
                    "publishedAt": "Two days ago",
                    "imageUrl": "https://source.unsplash.com/600x300?purple,abstract&random=96",
                    "action": {
                        "type": "navigation",
                        "route": "/media"
                    }
                },
                {
                    "type": "PostComponent",
                    "title": {
                        "type": "TextComponent",
                        "text": "Post 1"
                    },
                    "publishedAt": "Two days ago",
                    "imageUrl": "https://source.unsplash.com/600x300?purple,abstract&random=32",
                    "action": {
                        "type": "navigation",
                        "route": "/media"
                    }
                }
            ]
        }
    },
    "form": {
        "type": "DrawerPage",
        "title": "Ouvidoria",
        "body": {
            "type": "FormComponent",
            "children": [
                {
                    "type": "TextComponent",
                    "text": "Preencha o formulário abaixo para enviar sua mensagem"
                },
                {
                    "type": "TextInputComponent",
                    "label": "Nome",
                    "required": true
                },
                {
                    "type": "TextInputComponent",
                    "label": "Email",
                    "required": true
                },
                {
                    "type": "TextInputComponent",
                    "label": "Telefone",
                    "required": true
                },
                {
                    "type": "TextInputComponent",
                    "label": "Mensagem",
                    "required": true
                },
                {
                    "type": "FileInputComponent",
                    "label": "Anexo",
                    "required": false
                }
            ]
        }
    },
    "betha": {
        "type": "DrawerPage",
        "title": "Betha Educação",
        "body": {
            "type": "ButtonComponent",
            "label": "Adicionar aluno",
            "action": {
                "type": "modal",
                "child": {
                    "title": {
                        "type": "TextComponent",
                        "text": "Adicionar aluno"
                    },
                    "content": {
                        "type": "FormComponent",
                        "children": [
                            {
                                "type": "TextInputComponent",
                                "label": "Código do aluno",
                                "required": true
                            }
                        ],
                        "actions": [
                            {
                                "type": "ButtonComponent",
                                "label": "Adicionar",
                                "action": {
                                    "type": "navigation",
                                    "route": "/builder",
                                    "requestUrl": "http://localhost:3000/home"
                                }
                            },
                            {
                                "type": "ButtonComponent",
                                "label": "Cancelar",
                                "action": {
                                    "type": "navigation",
                                    "route": "/builder",
                                    "requestUrl": "http://localhost:3000/home"
                                }
                            }
                        ]
                    }
                }
            }
        }
    },
    "onStudentSent": {
        "type": "modal",
        "child": {
            "title": {
                "type": "TextComponent",
                "text": "Aluno adicionado"
            },
            "content": {
                "type": "TextComponent",
                "text": "O aluno foi adicionado com sucesso"
            },
            "actions": [
                {
                    "type": "ButtonComponent",
                    "label": "Ok",
                    "action": {
                        "type": "navigation",
                        "route": "/builder",
                        "requestUrl": "http://localhost:3000/home"
                    }
                }
            ]
        }
    }
}